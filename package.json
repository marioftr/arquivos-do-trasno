{
  "name": "trasno",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-ocr.mjs && vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "release": "node scripts/release.mjs",
    "list:info": "node scripts/list-info.mjs",
    "dev:web": "node scripts/copy-web-assets.mjs && vite -c vite.web.config.ts",
    "build:web": "node scripts/copy-web-assets.mjs && vite build -c vite.web.config.ts",
    "preview:web": "vite preview -c vite.web.config.ts --port 1422",
    "test:web": "node scripts/web-test.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@tesseract.js-data/cat": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/glg": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@tsconfig/svelte": "^5",
    "@types/three": "^0.187.0",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "~5.6",
    "vite": "^6"
  }
}
