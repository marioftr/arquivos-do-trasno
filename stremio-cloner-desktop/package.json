{
  "name": "stremio-cloner-desktop",
  "version": "1.0.0",
  "description": "Empaqueta stremio-account-addon-cloner como aplicación de escritorio",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare-app.mjs",
    "start": "electron .",
    "dist": "npm run prepare-app && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.stremio.account.addon.cloner",
    "productName": "Stremio Addon Cloner",
    "files": ["main.js"],
    "extraResources": [{ "from": "bundle", "to": "bundle" }],
    "win": { "target": ["portable", "nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] },
    "directories": { "output": "dist" }
  }
}
